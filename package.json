{
  "name": "whatbot",
  "version": "0.1.0",
  "private": true,
  "description": "A manually started WhatsApp group assistant for Windows",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/main.js",
    "setup": "node src/main.js --setup",
    "groups": "node src/main.js --groups",
    "check": "node src/main.js --check",
    "test": "node --test"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7"
  },
  "overrides": {
    "puppeteer": "25.16.0"
  }
}
